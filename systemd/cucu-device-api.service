[Unit]
Description=cucu-device API (FastAPI server)
After=network.target

[Service]
AmbientCapabilities=CAP_NET_BIND_SERVICE
User=davidedorigatti
WorkingDirectory=/home/davidedorigatti/cucu-device/api
# Gli upload video vengono spoolati da Starlette in TMPDIR prima di essere
# copiati a destinazione: se punta al default /tmp (spesso tmpfs = RAM),
# un episodio grande esaurisce la RAM e può far crashare VLC. Deve stare
# su disco, nella cartella del progetto.
Environment=TMPDIR=/home/davidedorigatti/cucu-device/tmp_uploads

ExecStart=/home/davidedorigatti/cucu-device/api/venv/bin/uvicorn main:app --host 0.0.0.0 --port 80

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
