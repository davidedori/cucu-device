[Unit]
Description=cucu-device NFC reader
After=network.target
# Il timing di plymouth-quit.service (systemd) rispetto a network.target varia
# da boot a boot (DHCP piu' o meno lento). Se plymouth-quit.service vince la
# corsa e fa "plymouth quit" senza --retain-splash prima che il nostro
# ExecStartPre giri, lo schermo va grigio prima che VLC sia pronto a
# disegnare. Questo Before= forza systemd a completare l'avvio di questo
# servizio (ExecStartPre incluso) prima di lanciare plymouth-quit.service.
Before=plymouth-quit.service plymouth-quit-wait.service

[Service]
Type=simple
User=davidedorigatti
Environment=XDG_RUNTIME_DIR=/run/user/__DEPLOY_UID__ TERM=linux
# "+" fa girare questo comando come root ignorando lo User= del servizio:
# plymouth quit --retain-splash richiede l'accesso al socket di controllo
# del demone (root-only, nessun gruppo "plymouth" delegato su questo sistema)
# e altrimenti fallisce sempre in silenzio (mascherato dal "-"), lasciando
# lo schermo grigio invece di congelare l'ultimo frame dell'animazione.
ExecStartPre=-+/usr/bin/plymouth quit --retain-splash
ExecStart=/usr/bin/python3 -u /home/davidedorigatti/cucu-device/read_nfc.py
WorkingDirectory=/home/davidedorigatti/cucu-device
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
